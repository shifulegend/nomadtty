# NomadTTY — systemd service for the Session Manager + MCP backend.
# Starts server/main.js (Session Manager on SESSION_MANAGER_PORT, loopback-only;
# MCP server on MCP_PORT, bind/auth controlled by MCP_HOST/MCP_AUTH_TOKEN).
# Env vars live in an EnvironmentFile, not inline, so MCP_AUTH_TOKEN never shows
# up in `systemctl cat`/unit file listings.
#
# This is a template: NOMADTTY_WORKING_DIR, NOMADTTY_NODE_BIN, and NOMADTTY_USER
# are substituted by install.sh (see its "Configuring nomadtty service" step).
# Copy to /etc/systemd/system/nomadtty.service after substitution, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nomadtty

[Unit]
Description=NomadTTY backend (Session Manager + MCP server)
After=network.target

[Service]
WorkingDirectory=NOMADTTY_WORKING_DIR
EnvironmentFile=/etc/nomadtty/nomadtty.env
ExecStart=NOMADTTY_NODE_BIN server/main.js
Restart=always
RestartSec=3
User=NOMADTTY_USER

[Install]
WantedBy=multi-user.target

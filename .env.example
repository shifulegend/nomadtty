# NomadTTY — example environment file for running `node server/main.js`
# directly (development / running from a local checkout without install.sh).
#
# Copy this file to `.env` and load it into your shell before starting the
# backend, e.g.:
#   set -a; source .env; set +a; node server/main.js
#
# `install.sh`/Docker generate their own equivalent file automatically at
# /etc/nomadtty/nomadtty.env — you don't need this file for those paths.
# Full documentation: .claude/rules/config.md and README.md.

# ── MCP server (server/mcp/**) ───────────────────────────────────────────
# Required once MCP_HOST is non-loopback (the default). Generate with:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=

# Set to 1 to allow the MCP server to boot on a non-loopback MCP_HOST with no
# MCP_AUTH_TOKEN. Local development only — never use in production.
#MCP_ALLOW_INSECURE=1

MCP_PORT=4200
MCP_HOST=0.0.0.0

# Tunables for MCP tool input validation (server/mcp/validation.js) — the
# defaults are sane for most uses; uncomment to override.
#MCP_MAX_TEXT_BYTES=8192
#MCP_MAX_LABEL_BYTES=256
#MCP_MAX_KEYS_PER_CALL=32
#MCP_MAX_LINES_REQUEST=5000
#MCP_MAX_CAPTURE_LINES=5000
#MCP_DENYLIST_ENABLED=1
#MCP_DENYLIST_EXTRA=
#MCP_FOLLOW_MAX_SECONDS=30

# ── Session Manager (server/session-manager.js) ──────────────────────────
SESSION_MANAGER_PORT=4000
TTYD_BASE_PORT=47900
TTYD_RENDERER_TYPE=dom
SESSION_MANAGER_SCROLL_LINES_MAX=200
#SESSION_MANAGER_START_DIR=
